/images/*
  Cache-Control: public, max-age=86400, must-revalidate

/ads.txt
  Cache-Control: public, max-age=86400

/robots.txt
  Cache-Control: public, max-age=86400

/sitemap.xml
  Cache-Control: public, max-age=86400

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/privacy
  Cache-Control: public, max-age=3600

/terms
  Cache-Control: public, max-age=3600

/favicon.ico
  Cache-Control: public, max-age=604800

/favicon-*
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/icon-*
  Cache-Control: public, max-age=604800

/og-image.jpg
  Cache-Control: public, max-age=86400

/site.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=86400

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()

# ── Quotation form (dppl.com.np/quotation) ──
# Only first-party scripts and styles; nothing can frame it from elsewhere.
/quotation
  Cache-Control: public, max-age=300
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'

# Step pages need the customer's earlier answers, so they are never indexed.
/quotation/*
  Cache-Control: public, max-age=300
  X-Robots-Tag: noindex
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'

/quotation/data/*
  Cache-Control: public, max-age=86400

# ── Admin hostname ── nothing served on it may be indexed
https://admin.dppl.com.np/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
